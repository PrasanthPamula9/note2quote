{
  "env": {
    "ANTHROPIC_BASE_URL": "https://openrouter.ai/api",
    "ANTHROPIC_AUTH_TOKEN": "",
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "qwen/qwen3-coder:free",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "nvidia/nemotron-3-nano-30b-a3b:free",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "nousresearch/hermes-3-llama-3.1-405b:free",
    "CLAUDE_CODE_SUBAGENT_MODEL": "liquid/lfm-2.5-1.2b-instruct:free"
  },
  "permissions": {
    "allow": [
      "Bash(ls android/gradlew*)",
      "Bash(ls android/*.bat)",
      "Bash(./gradlew app:installDebug -PreactNativeDevServerPort=8081)",
      "Bash(adb -s adb-IBKVCEFA5TAEN7XO-1aXzpS._adb-tls-connect._tcp shell getprop ro.product.cpu.abi)",
      "Bash(./gradlew :app:installDebug -PreactNativeDevServerPort=8081 --no-daemon -PreactNativeArchitectures=arm64-v8a)",
      "Bash(killall java:*)",
      "Bash(./gradlew :app:installDebug -PreactNativeDevServerPort=8081 -PreactNativeArchitectures=arm64-v8a --no-daemon)",
      "Bash(bash ./gradlew :app:installDebug -PreactNativeDevServerPort=8081 -PreactNativeArchitectures=arm64-v8a --no-daemon)"
    ]
  }
}
